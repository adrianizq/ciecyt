<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Reporte de estado de docentes: horas semanales asignadas a asesorias y jurados -->
    <changeSet id="20261105000001-1" author="ciecyt">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="docente_habilitado" columnName="horas_semanales"/>
            </not>
        </preConditions>
        <addColumn tableName="docente_habilitado">
            <column name="horas_semanales" type="int"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
