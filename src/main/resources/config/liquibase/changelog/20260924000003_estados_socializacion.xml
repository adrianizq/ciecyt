        <rollback>
            <update tableName="transicion_estado">
                <column name="activo" valueBoolean="true"/>
                <where>transicion_estado_modalidad_id IN (9001, 9003, 9006) AND id &lt; 97000</where>
            </update>
        </rollback>
    </changeSet>

