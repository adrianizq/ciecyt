<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">

    <!--
        Acuerdo 025 - Estados de socializacion para las modalidades sin jurado:
        9001 Pasantia Tecnologica, 9003 Pasantia Internacional y 9006 Publicacion de Articulo.
        Estas modalidades no requieren jurado (art. 9) y su acto publico es la socializacion
        (art. 14 par. 2), a diferencia de 9002 y 9004 que sustentan ante jurado.
        Este changelog sustituye la matriz de transiciones que creo 20260924000001 para estas tres
        modalidades (que las enviaba a jurado y a sustentacion) y la que dejo inactiva.
        Los estados de jurado, de sustentacion y de ajustes de sustentacion quedan inactivos
        para 9001, 9003 y 9006; el VIABLE tambien queda inactivo porque en estas modalidades la
        viabilidad y el concepto favorable los emite el asesor (art. 24 lit. b).
    -->

    <changeSet id="20260924000003-1" author="ciecyt">
        <comment>Acuerdo 025 art. 9 y 14 par. 2: desactivar estados de jurado y de sustentacion en 9001, 9003 y 9006</comment>
        <update tableName="estado_modalidad">
            <column name="activo" valueBoolean="false"/>
            <where>estado_modalidad_modalidad_id IN (9001, 9003, 9006)
                AND estado IN ('EN_REVISION_JURADO_PROPUESTA', 'CORRECCIONES_JURADO_PROPUESTA',
                'EN_REVISION_JURADO_PROYECTO', 'CORRECCIONES_JURADO_PROYECTO',
                'LISTO_PARA_SUSTENTAR', 'SUSTENTACION_PROGRAMADA', 'SUSTENTACION_REALIZADA',
                'EN_EVALUACION_SUSTENTACION', 'AJUSTES_SUSTENTACION', 'VIABLE')</where>
        </update>
        <rollback>
            <update tableName="estado_modalidad">
                <column name="activo" valueBoolean="true"/>
                <where>estado_modalidad_modalidad_id IN (9001, 9003, 9006)
                    AND estado IN ('EN_REVISION_JURADO_PROPUESTA', 'CORRECCIONES_JURADO_PROPUESTA',
                    'EN_REVISION_JURADO_PROYECTO', 'CORRECCIONES_JURADO_PROYECTO',
                    'LISTO_PARA_SUSTENTAR', 'SUSTENTACION_PROGRAMADA', 'SUSTENTACION_REALIZADA',
                    'EN_EVALUACION_SUSTENTACION', 'AJUSTES_SUSTENTACION', 'VIABLE')</where>
            </update>
        </rollback>
    </changeSet>

