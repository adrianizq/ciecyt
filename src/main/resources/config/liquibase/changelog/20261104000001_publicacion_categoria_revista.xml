<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Acuerdo 025, art. 7 par. 2: categoria de la revista para Publicacion de Articulo -->
    <changeSet id="20261104000001-1" author="ciecyt">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="proyecto" columnName="publicacion_categoria_revista"/>
            </not>
        </preConditions>
        <addColumn tableName="proyecto">
            <column name="publicacion_categoria_revista" type="varchar(2)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
