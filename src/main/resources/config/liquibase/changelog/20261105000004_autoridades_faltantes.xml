<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
      El sistema usa ROLE_ASESOR, ROLE_JURADO, ROLE_CIECYT y ROLE_ESTUDIANTE en el flujo y en
      roles_modalidad, pero la tabla jhi_authority solo sembraba ROLE_ADMIN y ROLE_USER. Sin
      estas filas el administrador no puede asignar esos roles desde la gestion de usuarios.
    -->

    <changeSet id="20261105000004-1" author="ciecyt">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM jhi_authority WHERE name = 'ROLE_ASESOR'</sqlCheck>
        </preConditions>
        <insert tableName="jhi_authority">
            <column name="name" value="ROLE_ASESOR"/>
        </insert>
    </changeSet>

    <changeSet id="20261105000004-2" author="ciecyt">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM jhi_authority WHERE name = 'ROLE_JURADO'</sqlCheck>
        </preConditions>
        <insert tableName="jhi_authority">
            <column name="name" value="ROLE_JURADO"/>
        </insert>
    </changeSet>

    <changeSet id="20261105000004-3" author="ciecyt">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM jhi_authority WHERE name = 'ROLE_CIECYT'</sqlCheck>
        </preConditions>
        <insert tableName="jhi_authority">
            <column name="name" value="ROLE_CIECYT"/>
        </insert>
    </changeSet>

    <changeSet id="20261105000004-4" author="ciecyt">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM jhi_authority WHERE name = 'ROLE_ESTUDIANTE'</sqlCheck>
        </preConditions>
        <insert tableName="jhi_authority">
            <column name="name" value="ROLE_ESTUDIANTE"/>
        </insert>
    </changeSet>

</databaseChangeLog>
