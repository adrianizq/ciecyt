  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "{,src/**/}*.{md,json,js,ts,css,scss}": [
      "prettier --write",
      "git add"
    ]
  },
  "scripts": {
    "build": "npm run typecheck && vite build",
    "clean-www": "rimraf target/classes/static/app/{src,target/}",
    "cleanup": "rimraf target/classes/static/",
    "lint": "eslint src/main/webapp/app src/test/javascript/spec",
    "lint:fix": "eslint src/main/webapp/app src/test/javascript/spec --fix",
    "prettier:format": "prettier --write \"{,src/**/}*.{md,json,js,ts,tsx,mjs,css,scss}\"",
    "serve": "vite",
    "start": "vite",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "test-ci": "npm run lint && npm run typecheck && npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
